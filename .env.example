# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard.

# Claude (bill photos, name matching, Kannada/Hindi replies)
ANTHROPIC_API_KEY=
# MUNSHI_MODEL=claude-opus-5-5

# WhatsApp Cloud API (Meta developer app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_DISPLAY_NUMBER=+1 555 000 0000
# WHATSAPP_API_VERSION=v25.0
# Optional approved templates for messages outside WhatsApp's 24-hour window:
# WHATSAPP_ORDER_TEMPLATE=munshi_order      (2 body params: shop name, order text)
# WHATSAPP_NUDGE_TEMPLATE=munshi_order_ready (1 body param: shop name)
# WHATSAPP_TEMPLATE_LANG=en

# Sarvam AI speech-to-text (voice notes)
SARVAM_API_KEY=

# Operator console at /admin (user: admin)
ADMIN_PASSWORD=

# Storage
MUNSHI_DB=./munshi.db
